{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Part I: Run Gridworld (shell-safe)",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/main.py",
                "--part",
                "1"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYGAME_HIDE_SUPPORT_PROMPT": "1"
                }
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Part II: Run Neon Rift Arena (shell-safe)",
            "type": "process",
            "command": "python",
            "args": [
                "${workspaceFolder}/main.py",
                "--part",
                "2"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PYGAME_HIDE_SUPPORT_PROMPT": "1"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
