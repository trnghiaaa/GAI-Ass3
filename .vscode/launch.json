{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Part I: Run Gridworld (safe)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "python": "python",
            "justMyCode": true,
            "redirectOutput": true,
            "env": {
                "PYGAME_HIDE_SUPPORT_PROMPT": "1"
            }
        },
        {
            "name": "Part I: Debug Gridworld",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "python": "python",
            "justMyCode": true,
            "redirectOutput": true,
            "env": {
                "PYGAME_HIDE_SUPPORT_PROMPT": "1"
            }
        }
    ]
}
