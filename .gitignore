# Python cache and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE and OS metadata
.DS_Store
Thumbs.db
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/

# Local recovery area for superseded training artifacts. It is intentionally
# excluded from the submission tree; use Git history or retraining as needed.
.archive/

# Rejected rotation anti-ram tuning candidates are kept locally for comparison,
# but are not submission artifacts. The currently promoted rotation model and
# its holdout evidence remain tracked normally.
/logs/arena/training/anti_ram_rotation_*/
/logs/arena/tensorboard/anti_ram_rotation_*/
/models/arena/anti_ram_rotation_*.zip
/models/arena/anti_ram_rotation_*.metadata.json

# Superseded anti-ram tuning is retained locally; the final edge-escape runs
# below replace it in the submitted evidence set.
/logs/arena/evidence/anti_ram_*
/logs/arena/training/anti_ram_direct_*/
/logs/arena/tensorboard/anti_ram_direct_*/
/models/arena/anti_ram_direct_*.zip
/models/arena/anti_ram_direct_*.metadata.json

# Keep only the final same-seed edge comparison, not exploratory cadence runs.
